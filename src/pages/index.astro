---
import '@fontsource-variable/rubik';
import { Image, getImage } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import { marked } from 'marked';
import * as iconos from 'simple-icons';

/* ------------------------------------------------------------------
   Esta página se arma sola a partir de:
     src/content/sitio.yaml        -> título, logo, redes, pie
     src/content/secciones/*.yaml  -> una sección por archivo, hecha de bloques
     src/assets/images/            -> todas las fotos
   Lo normal es editarlo todo desde el editor visual: npm run dev y abrir /admin.
   Mira COMO-EDITAR.md en la raíz del proyecto.
------------------------------------------------------------------ */

const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/*.{png,jpg,jpeg,webp,avif,gif,svg}',
  { eager: true },
);
const imagenes = Object.fromEntries(
  Object.entries(archivos).map(([ruta, mod]) => [ruta.split('/').pop()!, mod.default]),
);
/** Acepta "foto.png" o cualquier ruta que termine en "/foto.png". */
function imagen(nombre: string) {
  const base = nombre.split(/[\\/]/).pop()!;
  const img = imagenes[base];
  if (!img) {
    throw new Error(
      `No encuentro la imagen "${base}". Ponla en src/assets/images/ (disponibles: ${Object.keys(imagenes).join(', ')})`,
    );
  }
  return img;
}

const twitterPath =
  'M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z';
const enlacePath =
  'M3.9 12a3.1 3.1 0 0 1 3.1-3.1h4V7H7a5 5 0 0 0 0 10h4v-1.9H7A3.1 3.1 0 0 1 3.9 12zM8 13h8v-2H8v2zm9-6h-4v1.9h4a3.1 3.1 0 0 1 0 6.2h-4V17h4a5 5 0 0 0 0-10z';
/** Busca el icono de la marca en simple-icons; si no existe usa un icono de enlace. */
function icono(nombre: string) {
  const slug = nombre.toLowerCase().replace(/[^a-z0-9]/g, '');
  if (slug === 'twitter') return twitterPath;
  const clave = 'si' + slug.charAt(0).toUpperCase() + slug.slice(1);
  return (iconos as unknown as Record<string, { path: string }>)[clave]?.path ?? enlacePath;
}

/** **negrita** y *cursiva* para textos cortos. */
function mini(texto: string) {
  return texto
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>');
}

/* Formas del logo que adornan el borde de cada sección: [arriba, abajo], rotando entre tarjetas */
const adornos = [
  ['c', 'x'],
  ['t', 'c'],
  ['x', 't'],
] as const;

const sitio = (await getEntry('sitio', 'sitio'))!.data;
const logo = imagen(sitio.logo);
const ogImage = await getImage({ src: logo, format: 'png', width: 836 });
/* Easter egg: aparece al mantener presionado el logo (ver «Easter egg» en el script de abajo) */
const sorpresa = await getImage({ src: imagen('barcelonachair.png'), format: 'webp', width: 730 });
const title = sitio.titulo;
const description = sitio.descripcion;

const socials = (sitio.redes ?? []).map((r) => ({
  name: r.nombre,
  href: r.enlace,
  path: icono(r.icono),
}));

const secciones = (await getCollection('secciones'))
  .sort((a, b) => a.data.orden - b.data.orden || a.id.localeCompare(b.id))
  .map((s) => ({ id: s.id, titulo: s.data.titulo, bloques: s.data.bloques ?? [] }));

/** Saca el id de un enlace de YouTube (watch, youtu.be, shorts, live o embed). */
function youtubeId(url: string) {
  return url.match(/(?:youtu\.be\/|[?&]v=|\/shorts\/|\/embed\/|\/live\/)([\w-]{11})/)?.[1];
}

/* Apariencia (sitio.yaml -> tema) */
const color = (v: string | null | undefined, def: string) =>
  v && /^#[0-9a-f]{3,8}$/i.test(v.trim()) ? v.trim() : def;
const tema = {
  principal: color(sitio.tema?.principal, '#0668ab'),
  secundario: color(sitio.tema?.secundario, '#0280d6'),
  acento: color(sitio.tema?.acento, '#40b1b8'),
  burbujas: sitio.tema?.burbujas ?? true,
  formas: sitio.tema?.formas ?? true,
  destellos: sitio.tema?.destellos ?? true,
};

/* ==================================================================
   FONDO
   ================================================================== */
/** Número "al azar" pero siempre igual, para que el fondo no cambie en cada build. */
const azar = (i: number, sal: number) => {
  const x = Math.sin(i * 127.1 + sal * 311.7) * 43758.5453;
  return x - Math.floor(x);
};

/* Olas con los colores del tema. De la más lejana a la más cercana.
   h = altura, c = color, t = segundos por vuelta, sube = cuánto sube al hacer scroll (vh). */
const crestas = [
  'M0 50C150 30 300 30 450 50S650 75 800 55S1050 70 1200 50C1350 30 1500 30 1650 50S1850 75 2000 55S2250 70 2400 50',
  'M0 50C200 80 400 80 600 50S1000 20 1200 50C1400 80 1600 80 1800 50S2200 20 2400 50',
  'M0 50C100 65 250 80 400 60S700 20 900 40S1100 35 1200 50C1300 65 1450 80 1600 60S1900 20 2100 40S2300 35 2400 50',
];
const olas = [
  { h: '80vh', c: 'color-mix(in srgb, var(--deep) 90%, #000)', t: 64, bob: 9, k: 4, sube: 6, d: crestas[1] },
  { h: '66vh', c: 'color-mix(in srgb, var(--deep) 55%, var(--blue))', t: 46, bob: 7, k: 7, sube: 12, d: crestas[0], rev: true },
  { h: '52vh', c: 'var(--blue)', t: 32, bob: 6, k: 10, sube: 18, d: crestas[2] },
  { h: '38vh', c: 'var(--teal)', t: 38, bob: 8, k: 14, sube: 24, d: crestas[1], rev: true, o: 0.62 },
  { h: '25vh', c: 'color-mix(in srgb, var(--blue) 82%, #fff)', t: 24, bob: 5, k: 18, sube: 30, d: crestas[0] },
  { h: '12vh', c: 'color-mix(in srgb, var(--blue) 58%, #fff)', t: 17, bob: 4, k: 24, sube: 36, d: crestas[2], rev: true },
];

/* Formas del logo (c = círculo, t = triángulo, x = equis) repartidas a lo largo del scroll.
   Las "lejanas" son pequeñas, tenues y se mueven menos. */
const tipos = ['c', 't', 'x'] as const;
const formas = Array.from({ length: 22 }, (_, i) => {
  const lejos = i % 3 === 2;
  const lado = i % 2 ? 52 + azar(i, 1) * 44 : azar(i, 1) * 40; // izquierda / derecha, evitando el centro
  return {
    t: tipos[Math.floor(azar(i, 2) * 3)],
    x: lado,
    y: 4 + (i / 22) * 215 + azar(i, 3) * 8,
    s: lejos ? 18 + azar(i, 4) * 18 : 38 + azar(i, 4) * 80,
    d: 7 + azar(i, 5) * 7,
    prof: lejos ? 0.16 : 0.34 + azar(i, 6) * 0.2,
    lejos,
    giro: i % 2 ? -1 : 1,
  };
});

/* Burbujas que suben */
const burbujas = Array.from({ length: 16 }, (_, i) => ({
  x: 2 + azar(i, 7) * 96,
  s: 8 + azar(i, 8) * 26,
  d: 11 + azar(i, 9) * 14,
  delay: -azar(i, 10) * 25,
  vaiven: (azar(i, 11) - 0.5) * 90,
}));

/* Destellos en la parte alta */
const destellos = Array.from({ length: 18 }, (_, i) => ({
  x: azar(i, 12) * 100,
  y: azar(i, 13) * 46,
  s: 3 + azar(i, 14) * 5,
  d: 2.5 + azar(i, 15) * 4,
  delay: -azar(i, 16) * 6,
}));
---

<!doctype html>
<html lang="es" style={`--deep:${tema.principal};--blue:${tema.secundario};--teal:${tema.acento}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={tema.principal} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div class="sea" aria-hidden="true">
      <div class="puntos"></div>
      {
        tema.destellos && destellos.map((p) => (
          <i
            class="destello"
            style={`left:${p.x.toFixed(1)}%;top:${p.y.toFixed(1)}%;width:${p.s.toFixed(1)}px;--d:${p.d.toFixed(1)}s;animation-delay:${p.delay.toFixed(1)}s`}
          />
        ))
      }
      {
        olas.map((o) => (
          <div
            class="wave"
            style={`--h:${o.h};--c:${o.c};--t:${o.t}s;--bob:${o.bob}s;--k:${o.k}px;--sube:${o.sube}vh;--dir:${o.rev ? 'reverse' : 'normal'};opacity:${o.o ?? 1}`}
          >
            <svg class="crest" viewBox="0 0 2400 100" preserveAspectRatio="none">
              <path d={`${o.d}V100H0Z`} />
              <path class="espuma" d={o.d} />
              <path class="reflejo" d={o.d} />
            </svg>
          </div>
        ))
      }
      {
        tema.burbujas && burbujas.map((b) => (
          <i
            class="burbuja"
            style={`left:${b.x.toFixed(1)}%;width:${b.s.toFixed(0)}px;--d:${b.d.toFixed(1)}s;--vaiven:${b.vaiven.toFixed(0)}px;animation-delay:${b.delay.toFixed(1)}s`}
          />
        ))
      }
      {
        tema.formas && formas.map((f) => (
          <span
            class:list={['forma', { lejos: f.lejos }]}
            style={`left:${f.x.toFixed(1)}%;top:${f.y.toFixed(1)}%;width:${f.s.toFixed(0)}px;--d:${f.d.toFixed(1)}s;--giro:${f.giro};--prof:${f.prof.toFixed(2)}`}
          >
            <svg viewBox="0 0 40 40">
              {f.t === 'c' && <circle cx="20" cy="20" r="16" />}
              {f.t === 't' && <path d="M8 7 L33 20 L8 33 Z" />}
              {f.t === 'x' && (
                <>
                  <path class="borde" d="M10 10 L30 30 M30 10 L10 30" />
                  <path class="equis" d="M10 10 L30 30 M30 10 L10 30" />
                </>
              )}
            </svg>
          </span>
        ))
      }
    </div>

    <main class="pagina">
      <header class="portada">
        <h1 class="logo" data-sorpresa={sorpresa.src}>
          <Image
            src={logo}
            alt={title}
            width={560}
            densities={[1, 1.5]}
            loading="eager"
            fetchpriority="high"
            draggable="false"
          />
        </h1>
        {
          sitio.frase?.trim() && (
            <p class="frase">
              <i class="punto" aria-hidden="true" />
              <span>{sitio.frase}</span>
              <svg class="deco equis" viewBox="0 0 40 40" aria-hidden="true">
                <path class="borde" d="M10 10 L30 30 M30 10 L10 30" />
                <path class="trazo" d="M10 10 L30 30 M30 10 L10 30" />
              </svg>
              <svg class="deco triangulo" viewBox="0 0 40 40" aria-hidden="true">
                <path d="M8 7 L33 20 L8 33 Z" />
              </svg>
            </p>
          )
        }
        <a class="bajar" href={`#${secciones[0]?.id}`} aria-label="Bajar al contenido">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9l7 7 7-7" /></svg>
        </a>
      </header>

      <nav aria-label="Secciones">
        <span class="pill" aria-hidden="true"></span>
        {
          secciones.map((s, i) => (
            <a href={`#${s.id}`} data-tab={s.id} aria-current={i === 0 ? 'true' : undefined}>
              {s.titulo}
            </a>
          ))
        }
      </nav>

      {
        secciones.map((s, n) => (
          <section class="panel card" id={s.id}>
            <div class="adornos" aria-hidden="true">
              {adornos[n % adornos.length].map((f, k) => (
                <svg class:list={['deco', k ? 'abajo' : 'arriba', { equis: f === 'x' }]} viewBox="0 0 40 40">
                  {f === 'c' && <circle cx="20" cy="20" r="14" />}
                  {f === 't' && <path d="M8 7 L33 20 L8 33 Z" />}
                  {f === 'x' && (
                    <>
                      <path class="borde" d="M10 10 L30 30 M30 10 L10 30" />
                      <path class="trazo" d="M10 10 L30 30 M30 10 L10 30" />
                    </>
                  )}
                </svg>
              ))}
            </div>
            <h2 class="titulo">
              {s.titulo}
              <svg viewBox="0 0 120 12" aria-hidden="true">
                <path d="M3 6Q12 -1 21 6T39 6T57 6T75 6T93 6T117 6" pathLength="1" />
              </svg>
            </h2>

            {s.bloques.map((b) => (
              <>
                {b.tipo === 'texto' && b.texto && (
                  <div class="texto" set:html={marked.parse(b.texto, { async: false })} />
                )}

                {b.tipo === 'spoiler' && b.texto && (
                  <p>
                    <button class="spoiler" type="button" aria-expanded="false" title="Clic para revelar">
                      <span>{b.texto}</span>
                    </button>
                  </p>
                )}

                {b.tipo === 'galeria' && b.fotos?.length ? (
                  <ul class:list={['gds', { una: b.fotos.length === 1 }]}>
                    {b.fotos.map((g) => (
                      <li>
                        {g.enlace ? (
                          <a href={g.enlace} target="_blank" rel="noopener noreferrer">
                            <Image
                            src={imagen(g.imagen)}
                            alt={g.descripcion ?? ''}
                            width={315}
                            densities={[1, 2]}
                            loading="lazy"
                          />
                          </a>
                        ) : (
                          <span class="foto">
                            <Image
                            src={imagen(g.imagen)}
                            alt={g.descripcion ?? ''}
                            width={315}
                            densities={[1, 2]}
                            loading="lazy"
                          />
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                ) : null}

                {b.tipo === 'destacado' && (
                  <div class:list={['skin', { sola: !b.texto }]}>
                    <a
                      class="skin-img"
                      href={b.enlace || undefined}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <Image
                        src={imagen(b.imagen)}
                        alt={b.descripcion ?? ''}
                        width={290}
                        densities={[1, 2]}
                        loading="lazy"
                      />
                    </a>
                    {b.texto && <p set:html={mini(b.texto)} />}
                  </div>
                )}

                {b.tipo === 'boton' && b.texto && (
                  <p class="boton-fila">
                    <a class="boton" href={b.enlace || '#'} target="_blank" rel="noopener noreferrer">
                      {b.texto}
                    </a>
                  </p>
                )}

                {b.tipo === 'video' && b.enlace && youtubeId(b.enlace) && (
                  <div class="video">
                    <iframe
                      src={`https://www.youtube-nocookie.com/embed/${youtubeId(b.enlace)}`}
                      title="Video de YouTube"
                      loading="lazy"
                      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen
                    />
                  </div>
                )}

                {b.tipo === 'redes' && (
                  <ul class="socials">
                    {socials.map((r) => (
                      <li>
                        <a href={r.href} target="_blank" rel="noopener noreferrer" aria-label={r.name}>
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d={r.path} />
                          </svg>
                          <span class="tip">{r.name}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}

                {b.tipo === 'separador' && (
                  <svg class="separador" viewBox="0 0 200 12" aria-hidden="true">
                    <path d="M3 6Q12 -1 21 6T39 6T57 6T75 6T93 6T111 6T129 6T147 6T165 6T183 6T197 6" />
                  </svg>
                )}
              </>
            ))}
          </section>
        ))
      }

      {sitio.pie && <footer>( {sitio.pie} )</footer>}
    </main>

    {
      /* Música de fondo. Los navegadores no dejan que suene sola: empieza cuando el visitante toca el botón. */
      sitio.audio?.archivo && (
        <>
          <audio
            id="musica"
            src={`/audio/${encodeURIComponent(sitio.audio.archivo)}`}
            loop
            preload="auto"
            data-volumen={Math.min(1, Math.max(0, sitio.audio.volumen ?? 0.25))}
          />
          <button class="musica" type="button" aria-pressed="false" aria-label="Reproducir música" title="Música">
            <svg class="nota" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 18V6l10-2v12" />
              <circle cx="6.5" cy="18" r="2.5" />
              <circle cx="16.5" cy="16" r="2.5" />
            </svg>
            <span class="barras" aria-hidden="true"><i /><i /><i /><i /></span>
          </button>
        </>
      )
    }

    <style is:global>
      :root {
        --deep: #0668ab;
        --blue: #0280d6;
        --teal: #40b1b8;
        --ink: color-mix(in srgb, var(--deep) 52%, #0d1420);
        --card: #fff;
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
        /* Las actualiza el script: puntero (-1..1), scroll en px y scroll de 0 a 1 */
        --px: 0;
        --py: 0;
        --sy: 0;
        --s: 0;
        color-scheme: light;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
        background: color-mix(in srgb, var(--deep) 68%, #000);
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        padding: 0 16px;
        font-family: 'Rubik Variable', Rubik, system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        color: var(--ink);
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -webkit-tap-highlight-color: transparent;
      }

      /* ================= Fondo ================= */
      .sea {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        background:
          radial-gradient(
            ellipse 70% 45% at 50% -5%,
            color-mix(in srgb, var(--teal) 38%, transparent),
            transparent 70%
          ),
          radial-gradient(
            ellipse 40% 30% at 12% 20%,
            color-mix(in srgb, var(--blue) 35%, transparent),
            transparent 70%
          ),
          radial-gradient(
            ellipse 45% 30% at 90% 30%,
            color-mix(in srgb, var(--blue) 30%, transparent),
            transparent 70%
          ),
          linear-gradient(color-mix(in srgb, var(--deep) 56%, #000), var(--deep) 60%);
        animation: sea-in 1.2s ease-out both;
      }
      @keyframes sea-in {
        from {
          opacity: 0;
        }
      }
      /* Trama de puntos que se desvanece hacia abajo */
      .puntos {
        position: absolute;
        inset: -30px;
        background-image: radial-gradient(rgb(255 255 255 / 0.13) 1.6px, transparent 2.2px);
        background-size: 28px 28px;
        -webkit-mask-image: linear-gradient(#000, transparent 70%);
        mask-image: linear-gradient(#000, transparent 70%);
        transform: translate3d(
          calc(var(--px) * -8px),
          calc(var(--py) * -8px - var(--sy) * 0.05px),
          0
        );
      }
      .destello {
        position: absolute;
        aspect-ratio: 1;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 0 8px 2px rgb(255 255 255 / 0.45);
        animation: titilar var(--d) ease-in-out infinite alternate;
      }
      @keyframes titilar {
        from {
          opacity: 0.08;
          scale: 0.6;
        }
        to {
          opacity: 0.75;
          scale: 1;
        }
      }

      /* Cada ola: una cresta que se desliza en bucle + el cuerpo de agua debajo.
         Con el scroll todas suben, las cercanas más que las lejanas. */
      .wave {
        position: absolute;
        left: -40px;
        right: -40px;
        bottom: -60px;
        height: calc(var(--h) + 60px);
        color: var(--c);
        transform: translate3d(
          calc(var(--px) * var(--k)),
          calc(var(--py) * var(--k) * 0.5 - var(--s) * var(--sube)),
          0
        );
        animation: bob var(--bob) ease-in-out infinite alternate;
      }
      .wave::after {
        content: '';
        position: absolute;
        inset: 129px 0 0;
        background: linear-gradient(currentColor, color-mix(in srgb, currentColor 82%, #022a4d));
      }
      .crest {
        position: absolute;
        top: 0;
        left: 0;
        width: max(200%, 2000px);
        height: 130px;
        overflow: visible;
        fill: currentColor;
        animation: slide var(--t) linear infinite var(--dir);
        will-change: transform;
      }
      .crest .espuma,
      .crest .reflejo {
        fill: none;
        stroke: #fff;
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
      }
      .crest .espuma {
        stroke-width: 3;
        stroke-opacity: 0.55;
      }
      .crest .reflejo {
        stroke-width: 2;
        stroke-opacity: 0.2;
        stroke-dasharray: 60 34 18 46;
        transform: translateY(13px);
      }
      @keyframes slide {
        to {
          transform: translate3d(-50%, 0, 0);
        }
      }
      @keyframes bob {
        from {
          translate: 0 -12px;
        }
        to {
          translate: 0 14px;
        }
      }

      .burbuja {
        position: absolute;
        bottom: -50px;
        aspect-ratio: 1;
        border-radius: 50%;
        border: 2px solid rgb(255 255 255 / 0.6);
        background:
          radial-gradient(circle at 30% 30%, rgb(255 255 255 / 0.7) 0 11%, transparent 13%),
          rgb(255 255 255 / 0.07);
        animation: subir var(--d) linear infinite;
        will-change: transform;
      }
      @keyframes subir {
        0% {
          transform: translate3d(0, 0, 0);
          opacity: 0;
        }
        10% {
          opacity: 0.85;
        }
        50% {
          transform: translate3d(var(--vaiven), -55vh, 0);
        }
        85% {
          opacity: 0.7;
        }
        100% {
          transform: translate3d(0, -112vh, 0);
          opacity: 0;
        }
      }

      /* Círculos, triángulos y equis del logo */
      .forma {
        position: absolute;
        aspect-ratio: 1;
        transform: translate3d(
          calc(var(--px) * -26px),
          calc(var(--py) * -26px - var(--sy) * var(--prof) * 1px),
          0
        );
      }
      .forma.lejos {
        opacity: 0.45;
      }
      .forma svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
        fill: var(--teal);
        stroke: #fff;
        stroke-width: 5;
        stroke-linejoin: round;
        stroke-linecap: round;
        paint-order: stroke;
        animation: flotar var(--d) ease-in-out infinite alternate;
      }
      .forma .borde {
        fill: none;
        stroke-width: 15;
      }
      .forma .equis {
        fill: none;
        stroke: var(--teal);
        stroke-width: 7;
      }
      @keyframes flotar {
        from {
          translate: 0 -10px;
          rotate: calc(var(--giro) * -8deg);
        }
        to {
          translate: 0 12px;
          rotate: calc(var(--giro) * 10deg);
        }
      }

      /* ================= Página ================= */
      .pagina {
        width: min(720px, 100%);
        margin: 0 auto;
        padding-bottom: 12vh;
      }

      /* ---------- Portada ---------- */
      .portada {
        min-height: 100svh; /* ocupa toda la pantalla: el grupo queda justo en el centro */
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 28px;
        padding: 116px 0 76px; /* 20px más abajo que el centro exacto */
        /* se aleja y se desvanece al bajar */
        transform: translate3d(0, calc(var(--sy) * 0.3px), 0);
        opacity: calc(1 - var(--sy) / 420);
      }
      .logo {
        margin: 0;
        width: min(560px, 92vw);
        animation: logo-in 1s 0.1s var(--ease-out) both;
        cursor: pointer;
        user-select: none;
        -webkit-user-select: none;
        /* sin menú de «guardar imagen» al mantener presionado en el celular */
        -webkit-touch-callout: none;
        filter: drop-shadow(0 18px 22px rgb(2 30 60 / 0.45));
      }
      .logo img {
        display: block;
        width: 100%;
        height: auto;
        animation: float 6s ease-in-out infinite;
      }
      @keyframes logo-in {
        from {
          opacity: 0;
          scale: 0.7;
          rotate: -6deg;
        }
        60% {
          scale: 1.04;
          rotate: 1deg;
        }
      }
      @keyframes float {
        0%,
        100% {
          translate: 0 0;
          rotate: -0.6deg;
        }
        50% {
          translate: 0 -9px;
          rotate: 0.6deg;
        }
      }
      .bajar {
        display: grid;
        place-items: center;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        border: 2.5px solid rgb(255 255 255 / 0.85);
        color: #fff;
        animation:
          rise 0.8s 0.7s var(--ease-out) both,
          rebote 1.8s 1.5s ease-in-out infinite;
        transition: background 0.25s;
      }
      .bajar:hover {
        background: rgb(255 255 255 / 0.18);
      }
      .bajar svg {
        width: 22px;
        height: 22px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.6;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      @keyframes rebote {
        0%,
        100% {
          translate: 0 0;
        }
        50% {
          translate: 0 8px;
        }
      }

      /* ---------- Estado o frase bajo el logo ---------- */
      /* Una pegatina blanca como el contorno del logo, con sus formas en turquesa */
      .frase {
        position: relative;
        display: flex;
        align-items: center;
        gap: 11px;
        margin: -4px 0 4px;
        width: fit-content;
        max-width: min(620px, 86vw);
        padding: 10px 24px 10px 18px;
        border-radius: 26px;
        background: #fff;
        color: var(--deep);
        font-size: clamp(0.98rem, 2.7vw, 1.15rem);
        font-weight: 600;
        line-height: 1.3;
        text-align: left;
        text-wrap: balance;
        box-shadow:
          0 0 0 5px rgb(255 255 255 / 0.3),
          0 16px 24px -10px rgb(2 30 60 / 0.55);
        rotate: -1.5deg;
        animation:
          rise 0.8s 0.5s var(--ease-out) both,
          frase-flota 5s 1.3s ease-in-out infinite alternate;
      }
      @keyframes frase-flota {
        from {
          translate: 0 0;
          rotate: -1.5deg;
        }
        to {
          translate: 0 -6px;
          rotate: 0.5deg;
        }
      }
      /* Punto de "estado" que late */
      .frase .punto {
        position: relative;
        flex: none;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--teal);
      }
      .frase .punto::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 2px solid var(--teal);
        animation: latido 1.8s ease-out infinite;
      }
      @keyframes latido {
        from {
          scale: 1;
          opacity: 0.9;
        }
        to {
          scale: 2.6;
          opacity: 0;
        }
      }
      :is(.frase, .adornos) .deco {
        position: absolute;
        overflow: visible;
        fill: var(--teal);
        stroke: #fff;
        stroke-width: 6;
        stroke-linejoin: round;
        stroke-linecap: round;
        paint-order: stroke;
        filter: drop-shadow(0 4px 5px rgb(2 30 60 / 0.3));
        animation: flotar 4s ease-in-out infinite alternate;
      }
      .frase .equis {
        top: -15px;
        right: -10px;
        width: 30px;
        --giro: 1;
      }
      :is(.frase, .adornos) .equis .borde {
        fill: none;
        stroke-width: 16;
      }
      :is(.frase, .adornos) .equis .trazo {
        fill: none;
        stroke: var(--teal);
        stroke-width: 7;
      }
      .frase .triangulo {
        bottom: -14px;
        left: -12px;
        width: 26px;
        --giro: -1;
        animation-duration: 5.5s;
      }

      /* ---------- Botón de música ---------- */
      .musica {
        position: fixed;
        right: 16px;
        bottom: 16px;
        z-index: 6;
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: rgb(255 255 255 / 0.94);
        color: var(--deep);
        cursor: pointer;
        box-shadow: 0 10px 24px -8px rgb(2 38 74 / 0.6);
        animation: rise 0.8s 0.9s var(--ease-out) both;
        transition:
          scale 0.35s var(--ease-out),
          background 0.25s,
          color 0.25s;
      }
      .musica:hover {
        scale: 1.08;
      }
      .musica:active {
        scale: 0.93;
      }
      .musica[aria-pressed='true'] {
        background: var(--deep);
        color: #fff;
      }
      .musica .nota {
        width: 22px;
        height: 22px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .musica .nota circle {
        fill: currentColor;
      }
      .musica .barras {
        display: none;
        align-items: flex-end;
        gap: 3px;
        height: 18px;
      }
      .musica .barras i {
        width: 3px;
        height: 100%;
        border-radius: 2px;
        background: currentColor;
        transform-origin: bottom;
        animation: compas 0.9s ease-in-out infinite alternate;
      }
      .musica .barras i:nth-child(2) {
        animation-duration: 0.6s;
        animation-delay: -0.3s;
      }
      .musica .barras i:nth-child(3) {
        animation-duration: 1.1s;
        animation-delay: -0.5s;
      }
      .musica .barras i:nth-child(4) {
        animation-duration: 0.75s;
        animation-delay: -0.2s;
      }
      .musica[aria-pressed='true'] .nota {
        display: none;
      }
      .musica[aria-pressed='true'] .barras {
        display: flex;
      }
      @keyframes compas {
        from {
          transform: scaleY(0.25);
        }
        to {
          transform: scaleY(1);
        }
      }

      /* ---------- Barra de navegación (se queda arriba) ---------- */
      nav {
        position: sticky;
        top: 12px;
        z-index: 5;
        display: flex;
        gap: 2px;
        width: fit-content;
        max-width: 100%;
        margin: -78px auto 28px; /* se asoma al final de la portada */
        padding: 5px;
        border-radius: 999px;
        background: rgb(255 255 255 / 0.94);
        box-shadow: 0 10px 26px -8px rgb(2 38 74 / 0.55);
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        overflow-x: auto;
        scrollbar-width: none;
        animation: rise 0.8s 0.45s var(--ease-out) both;
      }
      nav::-webkit-scrollbar {
        display: none;
      }
      nav a {
        position: relative;
        z-index: 1;
        padding: 8px 18px;
        border-radius: 999px;
        color: var(--deep);
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
        transition:
          color 0.25s,
          scale 0.3s var(--ease-out);
      }
      nav a:hover {
        color: var(--blue);
      }
      nav a:active {
        scale: 0.94;
      }
      nav a[aria-current='true'] {
        color: #fff;
      }
      .pill {
        position: absolute;
        top: 0;
        left: 0;
        width: 0;
        height: 0;
        border-radius: 999px;
        background: var(--deep);
        opacity: 0;
        pointer-events: none;
      }
      html:not(.js) nav a[aria-current='true'] {
        background: var(--deep);
      }

      /* ---------- Tarjetas de sección ---------- */
      .card {
        margin-bottom: clamp(28px, 7vh, 64px);
        padding: clamp(22px, 4vw, 34px) clamp(16px, 4vw, 36px) clamp(24px, 4vw, 34px);
        position: relative;
        /* Borde de pegatina como las letras del logo: banda azul en dos tonos
           (oscuro arriba, claro abajo) con contorno blanco por fuera */
        border: 7px solid transparent;
        background:
          linear-gradient(var(--card), var(--card)) padding-box,
          linear-gradient(172deg, var(--deep) 0 46%, var(--blue) 46% 100%) border-box;
        border-radius: clamp(28px, 6vw, 40px);
        box-shadow:
          0 0 0 5px #fff,
          0 34px 60px -18px rgb(2 38 74 / 0.6);
        text-align: center;
        scroll-margin-top: 84px;
        transition:
          opacity 0.7s ease-out,
          translate 1s var(--ease-out),
          scale 1s var(--ease-out);
      }
      /* Aparecen al entrar en pantalla (el script añade .visto) */
      .js .card:not(.visto) {
        opacity: 0;
        translate: 0 56px;
        scale: 0.96;
      }
      .js .card.visto > :not(.adornos) {
        animation: rise 0.7s calc(var(--i, 0) * 80ms + 180ms) var(--ease-out) both;
      }
      /* Círculo, triángulo y equis del logo asomados sobre el borde */
      .adornos {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .adornos .arriba {
        top: -27px;
        left: clamp(18px, 6%, 40px);
        width: 42px;
        --giro: 1;
      }
      .adornos .abajo {
        bottom: -25px;
        right: clamp(18px, 6%, 40px);
        width: 38px;
        --giro: -1;
        animation-delay: -2s;
      }
      /* En las tarjetas pares cambian de lado */
      .card:nth-of-type(even) .arriba {
        left: auto;
        right: clamp(18px, 6%, 40px);
      }
      .card:nth-of-type(even) .abajo {
        right: auto;
        left: clamp(18px, 6%, 40px);
      }
      .card > :nth-child(2) {
        --i: 1;
      }
      .card > :nth-child(3) {
        --i: 2;
      }
      .card > :nth-child(4) {
        --i: 3;
      }
      .card > :nth-child(5) {
        --i: 4;
      }
      .card > :nth-child(n + 6) {
        --i: 5;
      }
      @keyframes rise {
        from {
          opacity: 0;
          translate: 0 14px;
          filter: blur(4px);
        }
      }

      .titulo {
        margin: 0 0 16px;
        font-size: clamp(1.35rem, 4.5vw, 1.7rem);
        font-weight: 700;
        line-height: 1.2;
        color: var(--deep);
      }
      /* Subrayado ondulado que se dibuja al aparecer */
      .titulo svg {
        display: block;
        width: 104px;
        margin: 6px auto 0;
        overflow: visible;
        fill: none;
        stroke: var(--teal);
        stroke-width: 4;
        stroke-linecap: round;
        stroke-dasharray: 1;
        stroke-dashoffset: 0;
        transition: stroke-dashoffset 1.1s 0.45s var(--ease-out);
      }
      .js .card:not(.visto) .titulo svg {
        stroke-dashoffset: 1;
      }

      /* Contenido escrito en Markdown */
      .panel :is(h3, h4) {
        margin: 6px 0 10px;
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--deep);
      }
      .texto a {
        color: var(--blue);
        text-underline-offset: 3px;
      }
      .texto :is(ul, ol) {
        display: inline-block;
        margin: 0 auto 12px;
        text-align: left;
      }
      .texto img {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 6px auto;
        border-radius: 14px;
      }

      p {
        margin: 0 auto 12px;
        max-width: 62ch;
        text-wrap: pretty;
      }
      strong {
        font-weight: 700;
        color: var(--deep);
      }

      /* ---------- Spoiler ---------- */
      .spoiler {
        font: inherit;
        color: inherit;
        padding: 2px 10px;
        border: 0;
        border-radius: 8px;
        background: rgb(6 104 171 / 0.14);
        cursor: pointer;
        transition: background 0.4s;
      }
      .spoiler span {
        display: inline-block;
        filter: blur(7px);
        opacity: 0.55;
        transition:
          filter 0.5s var(--ease-out),
          opacity 0.5s;
      }
      .spoiler:hover span {
        filter: blur(5px);
      }
      .spoiler[aria-expanded='true'] {
        background: rgb(6 104 171 / 0.07);
      }
      .spoiler[aria-expanded='true'] span {
        filter: none;
        opacity: 1;
      }

      /* ---------- Redes ---------- */
      .socials {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: clamp(6px, 3vw, 22px);
        margin: 14px 0 0;
        padding: 0;
        list-style: none;
      }
      .socials a {
        position: relative;
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        color: var(--deep);
        transition:
          color 0.25s,
          background 0.25s,
          translate 0.45s var(--ease-out),
          scale 0.45s var(--ease-out);
      }
      .socials svg {
        width: 30px;
        height: 30px;
        fill: currentColor;
      }
      .socials a:hover,
      .socials a:focus-visible {
        color: #fff;
        background: var(--teal);
        translate: 0 -5px;
        scale: 1.08;
      }
      .socials a:active {
        scale: 0.92;
      }
      .tip {
        position: absolute;
        bottom: calc(100% + 6px);
        left: 50%;
        padding: 3px 10px;
        border-radius: 999px;
        background: var(--deep);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        opacity: 0;
        translate: -50% 6px;
        scale: 0.9;
        pointer-events: none;
        transition:
          opacity 0.2s,
          translate 0.35s var(--ease-out),
          scale 0.35s var(--ease-out);
      }
      .socials a:hover .tip,
      .socials a:focus-visible .tip {
        opacity: 1;
        translate: -50% 0;
        scale: 1;
      }

      /* ---------- Galería ---------- */
      .gds {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px 28px;
        margin: 18px 0 0;
        padding: 0;
        list-style: none;
      }
      .gds.una {
        grid-template-columns: minmax(0, 340px);
        justify-content: center;
      }
      .skin.sola {
        grid-template-columns: minmax(0, 300px);
        justify-content: center;
      }
      .gds .foto img {
        border-radius: 14px;
      }
      .gds a,
      .gds .foto,
      .skin-img {
        display: block;
        border-radius: 14px;
        transition:
          translate 0.45s var(--ease-out),
          scale 0.45s var(--ease-out),
          filter 0.3s;
      }
      .gds img,
      .skin-img img {
        display: block;
        width: 100%;
        height: auto;
      }
      .gds a:hover,
      .gds a:focus-visible,
      .skin-img:hover,
      .skin-img:focus-visible {
        translate: 0 -5px;
        scale: 1.03;
        filter: drop-shadow(0 12px 14px rgb(2 38 74 / 0.35));
      }
      .gds a:active,
      .skin-img:active {
        scale: 0.97;
      }

      /* ---------- Imagen con texto ---------- */
      .skin {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 24px;
        margin-top: 18px;
      }
      .skin p {
        margin: 0;
      }

      /* ---------- Botón, video y separador ---------- */
      .boton-fila {
        margin-top: 16px;
      }
      .boton {
        display: inline-block;
        padding: 10px 24px;
        border-radius: 999px;
        background: var(--deep);
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 8px 16px -8px rgb(2 38 74 / 0.6);
        transition:
          background 0.25s,
          translate 0.45s var(--ease-out),
          scale 0.45s var(--ease-out);
      }
      .boton:hover,
      .boton:focus-visible {
        background: var(--blue);
        translate: 0 -3px;
        scale: 1.04;
      }
      .boton:active {
        scale: 0.96;
      }
      .video {
        max-width: 560px;
        margin: 18px auto 0;
        aspect-ratio: 16 / 9;
        border-radius: 18px;
        overflow: hidden;
        background: #000;
        box-shadow: 0 12px 24px -12px rgb(2 38 74 / 0.6);
      }
      .video iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
      }
      .separador {
        display: block;
        width: min(200px, 60%);
        margin: 18px auto;
        overflow: visible;
        fill: none;
        stroke: var(--teal);
        stroke-width: 4;
        stroke-linecap: round;
      }

      /* ---------- Pie ---------- */
      footer {
        padding-top: 8px;
        text-align: center;
        font-size: 13px;
        color: rgb(255 255 255 / 0.8);
        text-shadow: 0 1px 6px rgb(2 38 74 / 0.5);
      }

      /* ---------- Easter egg: mantener presionado el logo ---------- */
      .sorpresa {
        position: fixed;
        inset: 0;
        z-index: 20;
        display: grid;
        place-items: center;
        padding: 4vmin;
        background: rgb(2 20 40 / 0.72);
        cursor: pointer;
      }
      .sorpresa img {
        display: block;
        max-width: min(730px, 100%);
        max-height: 88vh;
        width: auto;
        height: auto;
        border-radius: 10px;
        box-shadow: 0 24px 60px rgb(0 0 0 / 0.6);
        user-select: none;
        -webkit-user-drag: none;
      }

      /* ---------- Onda al hacer clic (estilo hit circle) ---------- */
      .ripple {
        position: fixed;
        z-index: 10;
        width: 64px;
        height: 64px;
        margin: -32px 0 0 -32px;
        border: 3px solid #fff;
        border-radius: 50%;
        box-shadow:
          0 0 0 3px var(--teal),
          inset 0 0 0 3px var(--teal);
        pointer-events: none;
      }

      :focus-visible {
        outline: 2px solid var(--blue);
        outline-offset: 3px;
      }
      .portada :focus-visible {
        outline-color: #fff;
      }

      @media (max-width: 560px) {
        body {
          padding-inline: 10px;
        }
        .card {
          padding-inline: 14px;
        }
        .forma {
          scale: 0.7;
        }
        nav a {
          padding: 7px 11px;
          font-size: 14px;
        }
        .socials {
          flex-wrap: nowrap;
          gap: 2px;
        }
        .socials a {
          width: 44px;
          height: 44px;
        }
        .socials svg {
          width: 26px;
          height: 26px;
        }
        .gds {
          grid-template-columns: 1fr;
          gap: 12px;
          max-width: 340px;
          margin-inline: auto;
        }
        .skin {
          grid-template-columns: 1fr;
          gap: 14px;
        }
        .skin-img {
          max-width: 300px;
          margin-inline: auto;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation: none !important;
          transition-duration: 0.01ms !important;
        }
        .wave,
        .forma,
        .puntos,
        .portada {
          transform: none;
        }
        .portada {
          opacity: 1;
        }
        .burbuja {
          display: none;
        }
      }
    </style>

    <script>
      import { animate } from 'motion';

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const root = document.documentElement;
      const nav = document.querySelector<HTMLElement>('nav')!;
      const pill = document.querySelector<HTMLElement>('.pill')!;
      const tabs = [...nav.querySelectorAll<HTMLAnchorElement>('a[data-tab]')];
      const panels = [...document.querySelectorAll<HTMLElement>('.panel')];

      let current = tabs[0]?.dataset.tab ?? '';
      let pillPlaced = false;

      /* Pastilla que se desliza bajo la sección que estás viendo */
      function movePill(instant = false) {
        const tab = tabs.find((t) => t.dataset.tab === current);
        if (!tab) return;
        const to = {
          x: tab.offsetLeft,
          y: tab.offsetTop,
          width: tab.offsetWidth,
          height: tab.offsetHeight,
          opacity: 1,
        };
        if (instant || reduced || !pillPlaced) {
          animate(pill, to, { duration: 0 });
          pillPlaced = true;
        } else {
          animate(pill, to, { type: 'spring', stiffness: 420, damping: 32 });
        }
        // Si hay muchas secciones, mantiene visible la activa dentro de la barra
        if (nav.scrollWidth > nav.clientWidth) {
          nav.scrollTo({
            left: tab.offsetLeft - (nav.clientWidth - tab.offsetWidth) / 2,
            behavior: instant || reduced ? 'auto' : 'smooth',
          });
        }
      }

      function setCurrent(id: string) {
        if (id === current) return;
        current = id;
        tabs.forEach((t) =>
          t.dataset.tab === id
            ? t.setAttribute('aria-current', 'true')
            : t.removeAttribute('aria-current'),
        );
        movePill();
      }

      /* Las tarjetas aparecen al entrar en pantalla */
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add('visto');
            io.unobserve(e.target);
          }),
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
      );
      panels.forEach((p) => io.observe(p));

      /* Scroll: mueve el fondo y marca la sección actual */
      let pendiente = false;
      function alScroll() {
        pendiente = false;
        const y = scrollY;
        const max = Math.max(1, root.scrollHeight - innerHeight);
        if (!reduced) {
          root.style.setProperty('--sy', y.toFixed(1));
          root.style.setProperty('--s', Math.min(1, y / max).toFixed(4));
        }
        const linea = innerHeight * 0.45;
        let id = panels[0]?.id ?? '';
        for (const p of panels) if (p.getBoundingClientRect().top <= linea) id = p.id;
        if (y >= max - 2 && panels.length) id = panels[panels.length - 1].id;
        setCurrent(id);
      }
      addEventListener(
        'scroll',
        () => {
          if (pendiente) return;
          pendiente = true;
          requestAnimationFrame(alScroll);
        },
        { passive: true },
      );
      addEventListener('resize', alScroll);
      alScroll();

      movePill(true);
      document.fonts.ready.then(() => movePill(true));
      new ResizeObserver(() => movePill(true)).observe(nav);

      /* Música de fondo: el botón la enciende y apaga con un fundido suave */
      const musica = document.querySelector<HTMLAudioElement>('#musica');
      const botonMusica = document.querySelector<HTMLButtonElement>('.musica');
      if (musica && botonMusica) {
        const volumen = Math.min(1, Math.max(0, Number(musica.dataset.volumen) || 0.25));
        let reloj = 0;
        /** Lleva el volumen hasta `meta` poco a poco (con temporizador, para que funcione aunque la pestaña no esté a la vista). */
        function fundir(meta: number, ms: number, alTerminar?: () => void) {
          clearInterval(reloj);
          const inicio = musica!.volume;
          const t0 = Date.now();
          reloj = window.setInterval(() => {
            const p = Math.min(1, (Date.now() - t0) / ms);
            musica!.volume = Math.min(1, Math.max(0, inicio + (meta - inicio) * p));
            if (p < 1) return;
            clearInterval(reloj);
            alTerminar?.();
          }, 40);
        }
        const marcar = (sonando: boolean) => {
          botonMusica.setAttribute('aria-pressed', String(sonando));
          botonMusica.setAttribute('aria-label', sonando ? 'Pausar música' : 'Reproducir música');
        };
        const sonando = () => botonMusica.getAttribute('aria-pressed') === 'true';
        /** Devuelve false si el navegador no dejó reproducir (o el archivo no cargó). */
        async function encender() {
          clearInterval(reloj);
          try {
            if (musica!.paused) musica!.volume = 0;
            await musica!.play();
          } catch {
            return false;
          }
          marcar(true);
          fundir(volumen, 1200);
          return true;
        }
        /* Si el visitante la apaga, se recuerda para no volver a encenderla sola. */
        const CLAVE = 'musica-apagada';
        const recordar = (apagada: boolean) => {
          try {
            apagada ? localStorage.setItem(CLAVE, '1') : localStorage.removeItem(CLAVE);
          } catch {
            /* sin almacenamiento: no pasa nada */
          }
        };
        let apagadaAntes = false;
        try {
          apagadaAntes = localStorage.getItem(CLAVE) === '1';
        } catch {
          /* igual */
        }

        botonMusica.addEventListener('click', () => {
          if (!sonando()) {
            recordar(false);
            encender();
          } else {
            recordar(true);
            marcar(false);
            fundir(0, 500, () => musica.pause());
          }
        });

        /* Inicio automático: se intenta al cargar. Casi todos los navegadores lo bloquean
           hasta que el visitante interactúa, así que si falla arranca con su primer
           clic, toque o tecla en cualquier parte de la página. */
        if (!apagadaAntes) {
          const gestos = ['click', 'touchend', 'keydown'] as const;
          const alGesto = async (e: Event) => {
            const enBoton = e.target instanceof Node && botonMusica.contains(e.target);
            if (enBoton || sonando() || (await encender()))
              gestos.forEach((g) => removeEventListener(g, alGesto, true));
          };
          encender().then((ok) => {
            if (!ok) gestos.forEach((g) => addEventListener(g, alGesto, true));
          });
        }
      }

      /* Frase bajo el logo: si ocupa varias líneas, la pegatina se ciñe al ancho real del texto
         (CSS por sí solo la deja a todo el ancho, con un hueco vacío a la derecha). */
      const textoFrase = document.querySelector<HTMLElement>('.frase > span');
      if (textoFrase) {
        const cenir = () => {
          textoFrase.style.width = '';
          const rango = document.createRange();
          rango.selectNodeContents(textoFrase);
          const ancho = Math.max(...[...rango.getClientRects()].map((r) => r.width), 0);
          if (ancho) textoFrase.style.width = `${Math.ceil(ancho) + 1}px`;
        };
        cenir();
        document.fonts.ready.then(cenir);
        addEventListener('resize', cenir);
      }

      /* Spoilers */
      document.querySelectorAll<HTMLButtonElement>('.spoiler').forEach((spoiler) =>
        spoiler.addEventListener('click', () => {
          const open = spoiler.getAttribute('aria-expanded') === 'true';
          spoiler.setAttribute('aria-expanded', String(!open));
        }),
      );

      /* Rebote del logo */
      const logo = document.querySelector<HTMLElement>('.logo');
      let sorpresaAbiertaEn = 0;
      logo?.addEventListener('click', () => {
        if (reduced || performance.now() - sorpresaAbiertaEn < 600) return;
        animate(
          logo,
          { scale: [1, 0.9, 1.06, 1], rotate: [0, -3, 2, 0] },
          { duration: 0.6, ease: [0.16, 1, 0.3, 1] },
        );
      });

      /* Easter egg: mantener presionado el logo ~1 s muestra una imagen sorpresa.
         Se cierra con un clic, un toque o Escape. La imagen no se descarga hasta entonces. */
      const urlSorpresa = logo?.dataset.sorpresa;
      if (logo && urlSorpresa) {
        const ESPERA = 1000;
        let temporizador = 0;
        let apretando: ReturnType<typeof animate> | undefined;
        let capa: HTMLElement | undefined;

        const cerrar = () => {
          const c = capa;
          if (!c || performance.now() - sorpresaAbiertaEn < 400) return;
          capa = undefined;
          removeEventListener('keydown', alTeclear);
          if (reduced) return c.remove();
          animate(c, { opacity: [1, 0] }, { duration: 0.25 }).finished.then(() => c.remove());
        };
        const alTeclear = (e: KeyboardEvent) => {
          if (e.key === 'Escape') cerrar();
        };
        const abrir = () => {
          if (capa) return;
          sorpresaAbiertaEn = performance.now();
          const c = (capa = document.createElement('div'));
          c.className = 'sorpresa';
          c.setAttribute('role', 'dialog');
          c.setAttribute('aria-label', 'Barcelona chair');
          const img = new Image();
          img.alt = 'omg, is that a BARCELONA CHAIR?!?';
          img.draggable = false;
          img.src = urlSorpresa;
          c.append(img);
          c.addEventListener('click', cerrar);
          addEventListener('keydown', alTeclear);
          document.body.append(c);
          if (reduced) return;
          animate(c, { opacity: [0, 1] }, { duration: 0.2 });
          animate(
            img,
            { scale: [0.2, 1.08, 1], rotate: [-12, 3, 0] },
            { duration: 0.7, ease: [0.16, 1, 0.3, 1] },
          );
        };
        const soltar = () => {
          clearTimeout(temporizador);
          temporizador = 0;
          if (apretando) {
            apretando.cancel();
            apretando = undefined;
            logo.style.scale = '';
          }
        };

        logo.addEventListener('pointerdown', (e) => {
          if (e.button !== 0) return;
          soltar();
          /* el logo se encoge poco a poco mientras se mantiene presionado */
          if (!reduced) apretando = animate(logo, { scale: [1, 0.88] }, { duration: ESPERA / 1000, ease: 'easeIn' });
          temporizador = window.setTimeout(() => {
            soltar();
            abrir();
          }, ESPERA);
        });
        for (const fin of ['pointerup', 'pointerleave', 'pointercancel'] as const)
          logo.addEventListener(fin, soltar);
        /* En el celular, mantener presionada una imagen abre el menú del navegador */
        logo.addEventListener('contextmenu', (e) => e.preventDefault());
      }

      if (!reduced) {
        /* Onda al hacer clic */
        addEventListener('pointerdown', (e) => {
          const ring = document.createElement('span');
          ring.className = 'ripple';
          ring.style.left = `${e.clientX}px`;
          ring.style.top = `${e.clientY}px`;
          document.body.append(ring);
          animate(
            ring,
            { scale: [0.35, 1.25], opacity: [0.9, 0] },
            { duration: 0.55, ease: [0.16, 1, 0.3, 1] },
          ).finished.then(() => ring.remove());
        });

        /* Parallax suave con el puntero */
        if (matchMedia('(pointer: fine)').matches) {
          let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
          const tick = () => {
            x += (tx - x) * 0.06;
            y += (ty - y) * 0.06;
            root.style.setProperty('--px', x.toFixed(4));
            root.style.setProperty('--py', y.toFixed(4));
            raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.001 ? requestAnimationFrame(tick) : 0;
          };
          addEventListener(
            'pointermove',
            (e) => {
              tx = (e.clientX / innerWidth) * 2 - 1;
              ty = (e.clientY / innerHeight) * 2 - 1;
              raf ||= requestAnimationFrame(tick);
            },
            { passive: true },
          );
        }
      }
    </script>
  </body>
</html>
